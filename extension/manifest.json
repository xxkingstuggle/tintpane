{
  "manifest_version": 3,
  "name": "Tintpane",
  "version": "2.4.0",
  "description": "为每个 PWA 网站设置标题栏颜色，可跟随系统外观并区分活动窗口。",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tintpane",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/tintpane-16.png",
      "32": "icons/tintpane-32.png",
      "48": "icons/tintpane-48.png"
    }
  },
  "icons": {
    "16": "icons/tintpane-16.png",
    "32": "icons/tintpane-32.png",
    "48": "icons/tintpane-48.png",
    "128": "icons/tintpane-128.png"
  }
}
